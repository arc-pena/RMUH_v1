      "id": "DR1",
      "type": "Drape",
      "name": "Row 1 sites",
      "args": {
        "points": {
          "ref": "PR1"
        },
        "onto": {
          "ref": "SD"
        },
        "lift": 0,
        "miss": "Drop them"
      }
    },
    {
      "id": "DR2",
      "type": "Drape",
      "name": "Row 2 sites",
      "args": {
        "points": {
          "ref": "PR2"
        },
        "onto": {
          "ref": "SD"
        },
        "lift": 0,
        "miss": "Drop them"
