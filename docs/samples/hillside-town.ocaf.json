        },
        "quantity": "Size X"
      }
    },
    {
      "id": "EX",
      "type": "Expression",
      "name": "In metres",
      "args": {
        "a": {
          "value": 1,
          "from": "MS"
        },
        "b": 1,
        "c": 0,
        "formula": "a / 100"
      }
    },
    {
      "id": "PN",
      "type": "Panel",
      "name": "Site width",
      "args": {
